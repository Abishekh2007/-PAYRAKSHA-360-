{
  "name": "payraksha-360",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PAYRAKSHA 360 - explainable pre-payment scam defense. Hackathon demo: no real payments.",
  "scripts": {
    "dev": "vite",
    "dev:pay": "vite --config pay/vite.config.ts",
    "dev:auditor": "vite --config auditor/vite.config.ts",
    "dev:all": "node scripts/dev.mjs",
    "backend": "node scripts/backend.mjs",
    "build": "vite build && vite build --config pay/vite.config.ts && vite build --config auditor/vite.config.ts",
    "build:pay": "vite build --config pay/vite.config.ts",
    "build:auditor": "vite build --config auditor/vite.config.ts",
    "preview": "vite preview",
    "preview:pay": "vite preview --config pay/vite.config.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:py": "node scripts/pytest.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build:exe": "node scripts/build-exe.mjs",
    "test:exe": "node scripts/test-exe.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "framer-motion": "^13.4.6",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.48.0",
    "qrcode": "^1.5.4",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
