# PAYRAKSHA 360 — optional settings. Everything works with none of these set (DEMO / SIMULATION only).

# AI Auditor: an OpenAI-compatible endpoint. Unreachable → simulated auditor.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=payraksha-demo
PAYRAKSHA_AUDIT_MODEL=bedrock/zai.glm-5
PAYRAKSHA_AUDIT_TIMEOUT=75
# 0 = always use the simulated auditor
PAYRAKSHA_AUDIT_AI=1

# Vendor database: Postgres from docker-compose; falls back to SQLite automatically.
PAYRAKSHA_DB_URL=postgresql+psycopg://payraksha:payraksha@127.0.0.1:5433/payraksha_bank
# sqlite = force SQLite; PAYRAKSHA_BANK_DB sets its path (default ~/.payraksha/bank.db)
PAYRAKSHA_DB=
PAYRAKSHA_BANK_DB=

# Public RakshaPay address shown in the console's "Open on your phone" QR (e.g. your tailscale funnel URL)
PAYRAKSHA_PHONE_URL=
